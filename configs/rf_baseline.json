{
  "schema_version": 1,
  "experiment_id": "rf_tsfel_fold_local_reconstruction_v1",
  "status": "frozen_for_development",
  "research_question": "Can the camera-ready handcrafted-feature Random Forest baseline be independently reproduced under the fixed subject-disjoint protocol?",
  "protocol_config": "configs/mban_protocol.json",
